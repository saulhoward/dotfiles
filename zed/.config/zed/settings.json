{
  "icon_theme": "Zed (Default)",
  "features": {
    "edit_prediction_provider": "zed",
  },
  "edit_predictions": { "mode": "subtle" },
  "theme": "Vesper",
  "experimental.theme_overrides": {
    "surface.background": "#12141a",
    "background": "#12141a",
    "element.background": "#12141a",
    "editor.background": "#12141a",
    "editor.wrap_guide": "#1F212B",
    "editor.active_wrap_guide": "#101010",
  },
  "max_tabs": 7,
  "show_wrap_guides": true,
  "wrap_guides": [80],
  "buffer_font_size": null,
  "buffer_font_family": "TX-02 SemiCondensed",
  "buffer_line_height": "standard",
  "ui_font_family": "TX-02 Condensed",
  "vim_mode": true,
  "project_panel": {
    "dock": "right",
    "indent_size": 8,
    "file_icons": false,
    "folder_icons": false,
  },
  "unstable.ui_density": "compact",
  "git": {
    "inline_blame": {
      "min_column": 80,
    },
  },
  "agent": {
    "default_model": {
      "provider": "openai",
      "model": "gpt-5",
    },
    "model_parameters": [],
  },
  "prettier": {
    "allowed": true,
    "plugins": [
      "prettier-plugin-organize-imports",
      "prettier-plugin-tailwindcss",
      "prettier-plugin-svelte",
    ],
  },
  "lsp": {
    "gopls": {
      "initialization_options": {
        "directoryFilters": ["-**/node_modules", "-**/.git"],
        "gofumpt": true,
        "symbolScope": "workspace",
        "staticcheck": true,
        "templateExtensions": ["tmpl"],
        "experimentalPostfixCompletions": true,
        "analyses": {
          "nilness": true,
          "unusedparams": true,
          "unusedvariable": true,
          "unusedwrite": true,
          "useany": true,
        },
        "codelenses": {
          "gc_details": true,
        },
      },
    },
    "yaml-language-server": {
      "initialization_options": {
        "yaml": {
          "completion": false,
          "format": {
            "enable": false,
          },
        },
      },
    },
    "eslint": {
      "settings": {
        "workingDirectory": {
          "mode": "auto",
        },
      },
    },
  },
  "languages": {
    "Go": {
      "format_on_save": "on",
      "formatter": "language_server",
    },
    "Python": {
      "show_edit_predictions": true,
      "language_servers": ["pyright", "ruff"],
      "formatter": [
        {
          "code_action": "source.organizeImports.ruff",
        },
        {
          "code_action": "source.fixAll.ruff",
        },
        {
          "language_server": {
            "name": "ruff",
          },
        },
      ],
    },
    "Markdown": {
      "show_edit_predictions": false,
      "soft_wrap": "preferred_line_length",
      "format_on_save": "off",
      "formatter": {
        "external": {
          "command": "bunx",
          "arguments": [
            "prettier",
            "--prose-wrap",
            "always",
            "--stdin-filepath",
            "{buffer_path}",
          ],
        },
      },
    },
    "YAML": {
      "formatter": "language_server",
    },
  },
}
